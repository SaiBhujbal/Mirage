# MIRAGE ML-WAF Production Environment
# ==========================================
# COPY THIS TO .env AND FILL IN ALL VALUES
# NEVER COMMIT .env TO VERSION CONTROL!
# ==========================================

# ==========================================
# REQUIRED SECRETS - Generate these!
# ==========================================

# Redis password (generate with: openssl rand -base64 32)
REDIS_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD

# Redis command rename suffix (for SHUTDOWN command)
REDIS_SECRET_SUFFIX=CHANGE_ME_RANDOM_STRING

# Admin API key hash
# Generate key with: python -m core.secure_admin_keys generate
# Then set the hash here (NOT the actual key!)
MIRAGE_ADMIN_KEY_HASH=PASTE_HASH_FROM_KEY_GENERATION

# Model signing key (generate with: openssl rand -base64 32)
MODEL_SIGNING_KEY=CHANGE_ME_GENERATE_SIGNING_KEY

# Session encryption key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SESSION_ENCRYPTION_KEY=CHANGE_ME_GENERATE_FERNET_KEY

# Grafana credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ==========================================
# SIEM INTEGRATION (Optional)
# ==========================================

ENABLE_SIEM=true
# Syslog
# SIEM_SYSLOG_HOST=siem.yourdomain.com
# SIEM_SYSLOG_PORT=514
# Webhook
# SIEM_WEBHOOK_URL=https://siem.yourdomain.com/api/events

# ==========================================
# GEOBLOCKING (Optional)
# ==========================================

# ENABLE_GEOBLOCKING=true
# GEOIP_DB_PATH=/app/data/GeoLite2-Country.mmdb
# BLOCKED_COUNTRIES=KP,IR,SY

# ==========================================
# QUICK START COMMANDS
# ==========================================
# 
# 1. Generate Redis password:
#    openssl rand -base64 32
#
# 2. Generate admin API key:
#    python -m core.secure_admin_keys generate
#    (save the key securely, paste the hash above)
#
# 3. Generate model signing key:
#    openssl rand -base64 32
#
# 4. Generate session encryption key:
#    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# 5. Start services:
#    docker-compose -f docker-compose.production.yml up -d
#
# ==========================================
# SECURITY VERIFICATION
# ==========================================
#
# After starting, verify:
# - Redis is NOT accessible from outside (nmap -p 6379 your-server)
# - API requires authentication (curl http://your-server:8080/api/waf/rules)
# - TLS is enforced (check for HSTS header)
# - Grafana password is changed
# - Admin key file is deleted (if it existed)
#
