# ============================================
# MIRAGE ML-WAF - Environment Configuration
# ============================================
# Copy this to .env and fill in your values
# NEVER COMMIT .env TO VERSION CONTROL!
#
# Quick setup:
# 1. cp .env.example .env
# 2. Generate secrets (see commands below)
# 3. Edit .env and paste generated values

# ============================================
# CORE SETTINGS
# ============================================
ENV=development
HOST=0.0.0.0
PORT=8080
WORKERS=4
DEBUG=true
LOG_LEVEL=INFO

# ============================================
# SECURITY SETTINGS (REQUIRED FOR PRODUCTION)
# ============================================

# TLS/HTTPS - Auto-enabled in production
REQUIRE_TLS=false
MIN_TLS_VERSION=TLSv1.2

# ============================================
# REDIS (Session Storage)
# ============================================
SESSION_STORAGE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379

# IMPORTANT: Generate a strong password!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_MIN_32_CHARS

REDIS_DB=0
REDIS_USE_SSL=false

# Redis secret suffix for additional security
# Generate with: python -c "import secrets; print(secrets.token_hex(8))"
REDIS_SECRET_SUFFIX=

# ============================================
# SESSION ENCRYPTION (RECOMMENDED)
# ============================================
ENCRYPT_SESSION_DATA=true

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_ENCRYPTION_KEY=

# ============================================
# ADMIN AUTHENTICATION
# ============================================
# Generate admin key hash:
# admin_key=$(python -c "import secrets; print(secrets.token_urlsafe(32))")
# echo "Admin Key: $admin_key" # SAVE THIS!
# python -c "import hashlib; key='$admin_key'; print(hashlib.sha256(key.encode()).hexdigest())"

MIRAGE_ADMIN_KEY_HASH=

# API Authentication
REQUIRE_API_AUTH=false
API_KEY_STORAGE_PATH=./data/security
ADMIN_API_RATE_LIMIT=100

# ============================================
# MULTI-FACTOR AUTH (OPTIONAL)
# ============================================
# Requires: pip install pyotp
ENABLE_MFA_FOR_ADMIN=false

# ============================================
# ML MODEL SETTINGS
# ============================================
# Primary classifier model (XGBoost ONNX - trained on real-world dataset)
ML_MODEL_PATH=./models/http_classifier.onnx
# Anomaly detection model (Isolation Forest ONNX)
ML_ANOMALY_MODEL_PATH=./models/http_isolation_forest.onnx
# Feature scaler model (RobustScaler ONNX)
ML_SCALER_PATH=./models/http_scaler.onnx

ML_THRESHOLD_BLOCK=0.85
ML_THRESHOLD_SUSPICIOUS=0.5
ML_THRESHOLD_HONEYPOT=0.7

# Model integrity
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MODEL_SIGNING_KEY=

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BURST=20

# ============================================
# REQUEST LIMITS
# ============================================
MAX_REQUEST_BODY_SIZE=1048576
MAX_URL_LENGTH=8192
MAX_HEADER_SIZE=16384

# ============================================
# WAF ENGINE (waf/engine.py — the standalone LayeredWAF, gunicorn entrypoint)
# ============================================
# Bytes of query+body the signature/heuristic tier inspects. Anything larger is FAILED CLOSED
# (blocked) instead of being proxied uninspected (closes the truncation-bypass). Keep this
# >= MAX_REQUEST_BODY_SIZE so legitimate max-size bodies are fully inspected rather than
# blocked. Larger = more coverage, more per-request CPU (ReDoS-safe after remediation).
WAF_MAX_INSPECT_BYTES=1048576
# Hard ceiling; bodies beyond this are always rejected.
WAF_MAX_BODY_BYTES=2097152

# --- ML enforcement posture ---
# true  = ML enforces (out of shadow) but ONLY on high-confidence verdicts (see threshold).
# false = shadow: ML observes and logs a would-block, enforces nothing (safest until calibrated).
# The model false-positives on un-calibrated traffic — MEASURE your real false-positive rate on
# production benign traffic before enabling, and keep the threshold high until calibrated.
WAF_ML_ENFORCE=false
# Minimum ML malicious-probability required to BLOCK (0-1). High by default to bound false positives.
WAF_ML_ENFORCE_THRESHOLD=0.90
# Which ML model serves. Default = XGBoost + Mahalanobis (detector_v2).
#   "bytecnn" = research DualBranchNet (learned byte representation, ~7% FP on modern benign, shadow).
#   "gcid"    = Grammar-Conformance Intrusion Detection: DISTRIBUTION-FREE, ~0% FP on modern benign,
#               100% in-scope recall (injection + SSRF + CRLF/redirect). The ONLY model that passes
#               the harness --gate-ml (ENFORCEMENT READY = YES). Pure sklearn, no torch. See
#               ml/RESEARCH_GCID.md. Recommended for ML-based web-exploit detection.
WAF_ML_MODEL=gcid
# GCID enforcement (only used when WAF_ML_MODEL=gcid AND WAF_ML_ENFORCE=true). GCID blocks with a
# distribution-free false-alarm guarantee bounded by its conformal alpha. Still: canary + monitor on
# YOUR real traffic first — the harness corpus is representative, not exhaustive (a field that
# legitimately expects code/SQL is the known false-positive boundary).
WAF_GCID_ENFORCE=false
WAF_GCID_ENFORCE_ALPHA=0.002

# Content-type boundary: comma-separated path prefixes that LEGITIMATELY carry code/SQL/markup
# (an admin query console, a paste/snippet service, a GraphQL/DSL endpoint). On these routes the
# WAF still SCANS and LOGS every hit (recorded as a would-block for visibility) but does NOT 403 —
# detection without enforcement, so a field that is *supposed* to contain SQL isn't false-blocked.
# Safety-critical blocks (rate limit, fail-closed truncation/scan-error) are NEVER exempted.
# EMPTY = enforce everywhere (default). Example: WAF_SHADOW_ROUTES=/admin/query,/paste,/api/graphql
WAF_SHADOW_ROUTES=

# ============================================
# GEOBLOCKING (OPTIONAL)
# ============================================
ENABLE_GEOBLOCKING=false
GEOIP_DB_PATH=
BLOCKED_COUNTRIES=
ALLOWED_COUNTRIES=

# ============================================
# SIEM INTEGRATION (RECOMMENDED FOR PRODUCTION)
# ============================================
ENABLE_SIEM=false
SIEM_SYSLOG_HOST=
SIEM_SYSLOG_PORT=514
SIEM_WEBHOOK_URL=
SIEM_LOG_FILE=./data/siem/events.log

# ============================================
# SLACK ALERTS (integrations/slack_notifier.py)
# ============================================
# Incoming Webhook URL — SECRET, do not commit. Unset => dry-run (builds payloads, posts nothing).
# Create at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# Throttle: min seconds between posts of the same alert key (prevents attack-burst spam)
SLACK_MIN_INTERVAL_S=30
# Aggregation window seconds (identical events collapse to one message with a count)
SLACK_WINDOW_S=60

# --- TWO-WAY Slack (optional): approve/reject promotions + label captures from the channel
# Uses Socket Mode = OUTBOUND WebSocket only. No public endpoint, no inbound firewall rule.
# pip install slack_sdk
SLACK_BOT_TOKEN=          # xoxb-...  scopes: chat:write, commands
SLACK_APP_TOKEN=          # xapp-...  Socket Mode, scope: connections:write
SLACK_CHANNEL=            # channel ID to post approval requests to (e.g. C0123456789)
# Slack user IDs allowed to click approve/reject. EMPTY = every click is refused.
SLACK_APPROVERS=
# Set to "on" to HOLD every promotion until a human approves in Slack.
REQUIRE_SLACK_APPROVAL=

# ============================================
# TAVILY THREAT-INTEL (exploit acquisition -> ML training data)
# ============================================
# Collects the LATEST real web exploits/CVEs (by attack class, language, framework, version)
# via the Tavily search API, extracts attack payloads, and appends them as labeled training
# records to the MLOps capture feed. The guarded retrain (ml/mlops_runner) then screens them
# (poison guard) and accumulates them (zero-day store) before training a challenger.
# UNSET => disabled and offline-safe: the WAF and MLOps loop run normally without it.
# Get a key at https://tavily.com  (free tier available). Uses the REST API via `requests`.
TAVILY_API_KEY=
TAVILY_LOOKBACK_DAYS=7        # search recency window
TAVILY_MAX_RESULTS=5          # results per query
TAVILY_AUGMENT=0              # mutations per seed payload for training volume (0 = off)
# TAVILY_QUERIES=            # optional ';'-separated custom queries (else a built-in web-exploit set)

# ============================================
# DISTRIBUTED RATE LIMITING (multi-replica)
# ============================================
# Without this, the rate limit is PER PROCESS: 4 workers x 3 pods = 12x the intended budget.
# With it, all replicas share one atomic sliding window. Falls back to per-process if
# Redis is unreachable (fail-open: a limiter outage must not take the site down).
REDIS_URL=                # e.g. redis://redis:6379/0

# ============================================
# HOST-HEADER / CACHE-POISONING DETECTION
# ============================================
# Comma-separated hostnames this deployment legitimately serves. REQUIRED for host-header
# injection detection — unset means any Host is accepted and that check is OFF.
EXPECTED_HOSTS=           # e.g. bank.example.com,www.bank.example.com

# ============================================
# OPEN-REDIRECT ALLOWLIST
# ============================================
# Hosts a redirect parameter (next=, url=, return_to=, ...) may legitimately point at.
# An open redirect to an ARBITRARY host is indistinguishable from a legitimate one by shape
# alone (next=https://evil.com and next=https://myapp.com are identical in form), so this
# check is OFF unless you list your own hosts here. Defaults to EXPECTED_HOSTS when unset.
# Relative targets (next=/dashboard) are always allowed.
WAF_ALLOWED_REDIRECT_HOSTS=   # e.g. myapp.com,www.myapp.com

# ============================================
# AUDIT LOGGING
# ============================================
ENABLE_AUDIT_LOG=true
AUDIT_LOG_PATH=./data/audit/audit.log

# Audit log signing key
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUDIT_SIGNING_KEY=

# ============================================
# CORS (PRODUCTION)
# ============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================
# MONITORING (GRAFANA/PROMETHEUS)
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090

# Grafana Admin Password
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
GRAFANA_USER=admin
GRAFANA_PASSWORD=REPLACE_WITH_SECURE_PASSWORD_MIN_24_CHARS

# ============================================
# DOCKER-SPECIFIC SETTINGS
# ============================================
# Used by docker-compose.yml
REDIS_CONTAINER_NAME=mirage-redis
WAF_CONTAINER_NAME=mirage-waf
GRAFANA_CONTAINER_NAME=mirage-grafana
PROMETHEUS_CONTAINER_NAME=mirage-prometheus

# ============================================
# QUICK SETUP COMMANDS
# ============================================
# Run these commands and paste the output into .env:
#
# 1. Generate all secrets at once:
#
# python -c "
# import secrets, hashlib
#
# print('# === Paste these values into .env ===')
# admin_key = secrets.token_urlsafe(32)
# print(f'# SAVE THIS ADMIN KEY: {admin_key}')
# print(f'MIRAGE_ADMIN_KEY_HASH={hashlib.sha256(admin_key.encode()).hexdigest()}')
# print(f'REDIS_PASSWORD={secrets.token_urlsafe(32)}')
# print(f'REDIS_SECRET_SUFFIX={secrets.token_hex(8)}')
# print(f'SESSION_ENCRYPTION_KEY={secrets.token_hex(32)}')
# print(f'MODEL_SIGNING_KEY={secrets.token_hex(32)}')
# print(f'AUDIT_SIGNING_KEY={secrets.token_urlsafe(32)}')
# print(f'GRAFANA_PASSWORD={secrets.token_urlsafe(24)}')
# "
#
# 2. For production with Docker, also set:
# ENV=production
# REDIS_HOST=redis
# REQUIRE_TLS=true
# REQUIRE_API_AUTH=true
